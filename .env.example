# Server-side settings only. Set in Vercel -> Project Settings -> Environment Variables.
# Choose Production, then redeploy. Do not prefix any of these with NEXT_PUBLIC_.
# Copy to .env.local only if testing locally; .env.local is ignored by Git.
REMINDER_ENABLED=false
RESEND_API_KEY=
# For the free test sender, this must match the email used for your Resend account.
REMINDER_TO=
REMINDER_FROM="LeetCode Recall <onboarding@resend.dev>"
# Generate a random secret of at least 16 characters. Do not share it in chat.
CRON_SECRET=
APP_URL=https://recall.example.com/
REMINDER_TIME_ZONE=America/New_York
# The sending schedule is configured in vercel.json, not through these variables.
